# Environment variables read by config/settings/.
# Development works without any of these; production requires the Django ones.

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Email. Without DJANGO_EMAIL_HOST, production writes mail to the log instead of sending it,
# and development always prints it to the terminal.
DJANGO_DEFAULT_FROM_EMAIL=EventEase <no-reply@example.com>
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True

# SSLCommerz payment gateway (defaults: public sandbox test store)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_SANDBOX=True
